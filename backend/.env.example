PORT=3000
# Solo necesario en desarrollo (en prod el front lo sirve el mismo backend)
CORS_ORIGIN=http://localhost:5173

# Firebase (capa gratuita Spark). Credenciales de cuenta de servicio:
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Respetar los \n literales dentro de las comillas
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Clave simple para el Panel de Administración (se envía en el header x-admin-key)
ADMIN_KEY=
